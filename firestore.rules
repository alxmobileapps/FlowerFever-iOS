rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each player can read and write only their own save
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Player ID profiles: anyone in the game can look one up (nickname, levels, garden picture);
    // only the player who made it can change it. The document id is the Player ID, e.g. FF7K3Q9A.
    match /profiles/{pid} {
      function okProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'name', 'av', 'lv', 'stars', 'glv', 'g', 'at'])
          && d.uid == request.auth.uid
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
          && d.lv is number && d.stars is number && d.glv is number && d.av is number
          && d.g is string && d.g.size() <= 20000
          && d.at is number;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && pid.matches('FF[A-Z0-9]{6}') && okProfile();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && okProfile();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Water gifts: one document per friend per day (id: <their Player ID>_<YYYYMMDD>), never changed after.
      // Only the garden's owner can read and clear them.
      match /water/{wid} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['from', 'name', 'day', 'at'])
          && request.resource.data.from is string && request.resource.data.from != pid
          && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{8}')
          && request.resource.data.name is string && request.resource.data.name.size() <= 16
          && wid == request.resource.data.from + '_' + request.resource.data.day
          && get(/databases/$(database)/documents/profiles/$(request.resource.data.from)).data.uid == request.auth.uid;
        allow read, delete: if request.auth != null
          && get(/databases/$(database)/documents/profiles/$(pid)).data.uid == request.auth.uid;
      }

      // Coin gifts: 100 flower coins, one per friend per day (id: <their Player ID>_<YYYYMMDD>), never changed after.
      match /coins/{gid} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['from', 'name', 'day', 'n', 'at'])
          && request.resource.data.n == 100
          && request.resource.data.from is string && request.resource.data.from != pid
          && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{8}')
          && request.resource.data.name is string && request.resource.data.name.size() <= 16
          && gid == request.resource.data.from + '_' + request.resource.data.day
          && get(/databases/$(database)/documents/profiles/$(request.resource.data.from)).data.uid == request.auth.uid;
        allow read, delete: if request.auth != null
          && get(/databases/$(database)/documents/profiles/$(pid)).data.uid == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
